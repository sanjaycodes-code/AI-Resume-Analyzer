# ============================================================
# AI Resume Analyzer — Server Environment Configuration
# ============================================================

# Environment Mode (development | production | test)
NODE_ENV=development

# Server Port (Render sets this dynamically via $PORT)
PORT=5000

# Client Application URL (Strictly locked for CORS & Cross-Origin Cookies)
# Development: http://localhost:5173
# Production:  https://your-frontend.vercel.app
CLIENT_URL=http://localhost:5173

# MongoDB Atlas Database Connection URI
# Example: mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/ai-resume-analyzer?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/ai-resume-analyzer?retryWrites=true&w=majority

# JWT Authentication Secrets (Generate via: openssl rand -base64 32)
JWT_SECRET=your_super_secret_jwt_access_key_min_32_chars_long
JWT_REFRESH_SECRET=your_super_secret_jwt_refresh_key_min_32_chars_long

# Google Gemini AI API Configuration
AI_PROVIDER=gemini
AI_API_KEY=your_gemini_api_key_from_google_ai_studio
GEMINI_MODEL=gemini-3.6-flash

# Optional: Cloudinary Cloud Storage (For persistent cloud resume storage)
# If omitted, resumes are stored locally in server/uploads/resumes
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Optional: Private Demo Invite Code
# If set, users must provide this code during registration. If left blank, registration is open.
DEMO_INVITE_CODE=

# Optional: Email Service Configuration for Password Resets
# Option A: Resend API (Free account at https://resend.com)
RESEND_API_KEY=
EMAIL_FROM=AI Resume Analyzer <onboarding@resend.dev>

# Option B: Free Gmail SMTP via Nodemailer (No custom domain required, sends to any recipient!)
# Generate an App Password at: https://myaccount.google.com/apppasswords
SMTP_USER=your_gmail_address@gmail.com
SMTP_PASS=your_16_character_app_password

